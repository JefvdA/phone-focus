<?xml version="1.0" encoding="utf-8"?>
<!-- Retro cover-screen widget (#13). The Flip's two cameras cut into the bottom-left corner of
     the cover screen, so that corner stays empty: the quick buttons sit bottom-right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/retro_desktop"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/cover_window"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/retro_window"
        android:contentDescription="@string/cover_open_description"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/retro_title_bar"
            android:fontFamily="@font/pixelify_sans"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="@string/app_name"
            android:textColor="@color/retro_on_title_bar"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@drawable/retro_field"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextClock
                android:id="@+id/cover_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixelify_sans"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:maxLines="1"
                android:textColor="@color/retro_text"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cover_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pixelify_sans"
                android:maxLines="1"
                android:text="@string/cover_status_placeholder"
                android:textColor="@color/retro_text"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Kept empty: the camera cutouts. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cover_button_call"
                    android:text="Call"
                    style="@style/CoverWidgetButton"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/cover_button_music"
                    android:text="Music"
                    style="@style/CoverWidgetButton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cover_button_camera"
                    android:text="Camera"
                    style="@style/CoverWidgetButton"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/cover_button_timer"
                    android:text="Timer"
                    style="@style/CoverWidgetButton" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
