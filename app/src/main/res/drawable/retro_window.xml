<?xml version="1.0" encoding="utf-8"?>
<!-- A 90s window frame (raised bevel around the grey window surface). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/retro_bevel_dark" /></shape>
    </item>
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/retro_bevel_light" /></shape>
    </item>
    <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/retro_shadow_mid" /></shape>
    </item>
    <item android:bottom="4dp" android:left="2dp" android:right="4dp" android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/retro_surface" /></shape>
    </item>
</layer-list>
