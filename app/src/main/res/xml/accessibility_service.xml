<?xml version="1.0" encoding="utf-8"?>
<!-- The app blocker (#11). Window-state changes say when another app comes to the front;
     the window list (interactive windows, window content) tells which apps are on screen. It
     never reads text, never performs gestures and keeps nothing. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_service_summary" />
